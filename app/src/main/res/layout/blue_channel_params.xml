<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/llBlueChannel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="14dp"
    android:layout_marginBottom="18dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_blue_channel"
        android:textColor="@color/rgb_blue"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="12dp">

        <SeekBar
            android:id="@+id/sbBlueLow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="700"
            android:progress="100"/>

        <SeekBar
            android:id="@+id/sbBlueMid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="700"
            android:progress="250"/>

        <SeekBar
            android:id="@+id/sbBlueHigh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="700"
            android:progress="400"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/tvBlueRange"
            android:text="100-250-400Hz"
            android:textColor="@color/text_hint"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginTop="4dp"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView

            android:layout_height="wrap_content"
            android:text="@string/label_calc_model"
            android:textColor="@color/text_hint"
            android:textSize="13sp"
            android:layout_width="70dp"/>

        <Spinner
            android:id="@+id/spBlueModel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_height="wrap_content"
            android:text="@string/label_channel_gain"
            android:textColor="@color/text_hint"
            android:textSize="12sp"
            android:layout_width="70dp"/>

        <SeekBar
            android:id="@+id/sbBlueGain"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="100"
            android:progress="40"/>

        <TextView
            android:layout_height="wrap_content"
            android:id="@+id/tvBlueGain"
            android:text="4.0"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_width="40dp"
            android:gravity="right"/>

    </LinearLayout>

</LinearLayout>