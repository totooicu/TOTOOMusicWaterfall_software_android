<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/llGlobalGain"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_global_settings"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_height="wrap_content"
            android:text="@string/label_brightness"
            android:textColor="@color/text_hint"
            android:textSize="12sp"
            android:layout_width="70dp"/>

        <SeekBar
            android:id="@+id/sbBrightness"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="100"
            android:progress="80"/>

        <TextView
            android:layout_height="wrap_content"
            android:id="@+id/tvBrightness"
            android:text="80%"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_width="45dp"
            android:gravity="right"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_height="wrap_content"
            android:text="@string/label_mic_gain"
            android:textColor="@color/text_hint"
            android:textSize="12sp"
            android:layout_width="70dp"/>

        <SeekBar
            android:id="@+id/sbMicGain"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="100"
            android:progress="50"/>

        <TextView
            android:layout_height="wrap_content"
            android:id="@+id/tvMicGain"
            android:text="50%"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_width="45dp"
            android:gravity="right"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_height="wrap_content"
            android:text="@string/label_history_size"
            android:textColor="@color/text_hint"
            android:textSize="12sp"
            android:layout_width="70dp"/>

        <SeekBar
            android:id="@+id/sbHistorySize"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="200"
            android:progress="100"/>

        <TextView
            android:layout_height="wrap_content"
            android:id="@+id/tvHistorySize"
            android:text="100"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_width="45dp"
            android:gravity="right"/>

    </LinearLayout>

</LinearLayout>