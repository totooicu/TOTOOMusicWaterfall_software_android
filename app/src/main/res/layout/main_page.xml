<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:padding="16dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include layout="@layout/header_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <include layout="@layout/control_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <include layout="@layout/progress_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="20dp">

            <include layout="@layout/ring_section"
                android:layout_width="300dp"
                android:layout_height="300dp"/>

        </LinearLayout>

        <include layout="@layout/rgb_values"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <include layout="@layout/channel_bars"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <include layout="@layout/spectrum_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <include layout="@layout/params_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="项目开源地址"
                android:textColor="@color/text_hint"
                android:textSize="12sp"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="https://github.com/totooicu/TOTOOMusicWaterfall_software_android.git"
                android:autoLink="web"
                android:linksClickable="true"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:padding="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="https://github.com/totooicu/TOTOOMusicWaterfall_hardware_screen.git"
                android:autoLink="web"
                android:linksClickable="true"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:padding="4dp"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>